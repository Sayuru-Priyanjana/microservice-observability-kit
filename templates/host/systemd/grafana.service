# Grafana of the observability stack @@STACK_NAME@@ (GRAFANA_MODE=bundled). Generated by render.sh.
[Unit]
Description=@@STACK_NAME@@ Grafana
After=network-online.target @@STACK_NAME@@-prometheus.service @@STACK_NAME@@-tempo.service
Wants=network-online.target

[Service]
User=@@STACK_NAME@@
Group=@@STACK_NAME@@
WorkingDirectory=/opt/@@STACK_NAME@@/grafana
# GF_SECURITY_ADMIN_PASSWORD (only used when the database is created)
EnvironmentFile=@@CONFIG_DIR@@/grafana/admin.env
Environment=GF_PATHS_DATA=@@DATA_DIR@@/grafana
Environment=GF_PATHS_LOGS=@@DATA_DIR@@/grafana/log
Environment=GF_PATHS_PLUGINS=@@DATA_DIR@@/grafana/plugins
Environment=GF_PATHS_PROVISIONING=@@CONFIG_DIR@@/grafana/provisioning
Environment=GF_SERVER_HTTP_ADDR=@@BIND_ADDRESS@@
Environment=GF_SERVER_HTTP_PORT=@@GRAFANA_PORT@@
Environment=GF_SECURITY_ADMIN_USER=admin
Environment=GF_USERS_ALLOW_SIGN_UP=false
Environment=GF_AUTH_ANONYMOUS_ENABLED=false
Environment=GF_ANALYTICS_REPORTING_ENABLED=false
Environment=GF_ANALYTICS_CHECK_FOR_UPDATES=false
Environment=GF_SECURITY_DISABLE_GRAVATAR=true
ExecStart=/opt/@@STACK_NAME@@/grafana/bin/grafana server --homepath=/opt/@@STACK_NAME@@/grafana
Restart=always
RestartSec=5
MemoryMax=@@GRAFANA_MEMORY_LIMIT_SYSTEMD@@
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=@@DATA_DIR@@/grafana

[Install]
WantedBy=multi-user.target
