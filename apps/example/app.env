# One app (a group of services shown together in Grafana). Copy this folder to apps/<name>/,
# edit, and add <name> to APPS in kit.env.

APP_NAME=example
# Overrides kit.env ENVIRONMENT for this app (empty = kit.env value).
ENVIRONMENT=

# Regex matching the OTEL_SERVICE_NAME of this app's services. Dashboards only show these.
# On Kubernetes the kit sets OTEL_SERVICE_NAME = deployment name, so it must match the deployments.
SERVICE_REGEX=example-.*

# Grafana folder / dashboard naming. UID prefix must be unique per app (Grafana uids are global).
DASHBOARD_FOLDER="Example"
DASHBOARD_UID_PREFIX=example-
DASHBOARD_TITLE_PREFIX="Example - "

# Dashboards (templates/dashboards/*.json). Empty = default for the target:
#   traces service-overview + kubernetes-resources (kubernetes, INFRA_METRICS=federate)
#                            + containers-hosts (compose / nomad / host with infra metrics)
# Optional: user-actions (needs a `user.action` baggage entry set by the app's own code).
DASHBOARDS=

# compose / nomad / host: regex of this app's container names in the containers-hosts dashboard.
CONTAINER_REGEX=.*

# ---------------------------------------------------------------- kubernetes only
APP_NAMESPACE=example
# Deployments to instrument: deployment[:container[:mode]]
#   container defaults to the deployment name
#   mode java (default): adds the OTel Java agent with an init container, no image change
#   mode env           : only sets the OTEL_* environment (the image already contains an OTel SDK
#                        or auto-instrumentation: Node.js, Python, .NET, Go ... see docs/instrumentation.md)
TARGETS="example-api example-worker:worker example-web:web:env"
