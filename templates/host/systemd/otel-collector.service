# OTel Collector gateway of the observability stack @@STACK_NAME@@. Generated by render.sh.
[Unit]
Description=@@STACK_NAME@@ OpenTelemetry Collector (gateway)
After=network-online.target @@STACK_NAME@@-tempo.service
Wants=network-online.target

[Service]
User=@@STACK_NAME@@
Group=@@STACK_NAME@@
ExecStart=/usr/local/bin/otelcol-contrib --config=@@CONFIG_DIR@@/otel-collector/config.yaml
Restart=always
RestartSec=5
# memory_limiter in the config is a percentage of this limit
MemoryMax=@@GATEWAY_MEMORY_LIMIT_SYSTEMD@@
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
