# Example: OTel settings for a Java task of app @@APP_NAME@@ in Nomad. Generated by render.sh.
# Copy the artifact and template blocks into the task (Docker driver shown; for exec / java
# drivers use "local/opentelemetry-javaagent.jar" as the path). The gateway is found through the
# Nomad service "@@STACK_NAME@@-otlp"; nothing else needs to know where the stack runs.
task "my-service" {
  # ...existing driver / config...

  artifact {
    source      = "@@JAVA_AGENT_URL@@"
    destination = "local/"
    mode        = "file"
  }

  template {
    destination = "local/otel.env"
    env         = true
    change_mode = "restart"
    data        = <<-EOT
      OTEL_SERVICE_NAME={{ env "NOMAD_TASK_NAME" }}
      OTEL_RESOURCE_ATTRIBUTES=deployment.environment=@@ENVIRONMENT@@,host.name={{ env "node.unique.name" }}
      {{- range nomadService "@@STACK_NAME@@-otlp" }}
      OTEL_EXPORTER_OTLP_ENDPOINT=http://{{ .Address }}:{{ .Port }}
      {{- end }}
      OTEL_EXPORTER_OTLP_PROTOCOL=grpc
      OTEL_TRACES_EXPORTER=otlp
      OTEL_METRICS_EXPORTER=otlp
      OTEL_LOGS_EXPORTER=none
      OTEL_PROPAGATORS=tracecontext,baggage
      OTEL_METRIC_EXPORT_INTERVAL=15000
      OTEL_TRACES_SAMPLER=@@OTEL_TRACES_SAMPLER@@
      OTEL_TRACES_SAMPLER_ARG=@@TRACE_SAMPLE_RATIO@@
      JAVA_TOOL_OPTIONS=-javaagent:/local/opentelemetry-javaagent.jar
    EOT
  }
  # OTEL_SERVICE_NAME = task name: it must match @@SERVICE_REGEX@@. The agent adds ~100 MB of
  # memory and 10-60 s of startup time: raise `memory` and the check's grace period.
}
