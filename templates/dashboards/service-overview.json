          },
          "refId": "A",
          "expr": "topk(15, sum by (service_name, http_route) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\", instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{service_name}} {{http_route}}"
        }
