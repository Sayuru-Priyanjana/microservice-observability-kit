# Infrastructure metrics for the observability stack @@STACK_NAME@@ (INFRA_METRICS=nomad).
# Generated by render.sh. System job: node-exporter (host) and cAdvisor (containers) on EVERY
# client, registered in Nomad's service catalog with the tag "metrics"; the stack's Prometheus
# finds them there.   nomad job run infra.nomad.hcl
# Ports: node-exporter 9100, cAdvisor 9338 (firewall: reachable from node @@NOMAD_NODE_NAME@@ only).

job "@@STACK_NAME@@-infra" {
  datacenters = [@@NOMAD_DATACENTERS@@]
  namespace   = "@@NOMAD_NAMESPACE@@"
  type        = "system"

  group "infra" {
    network {
      mode = "host"
      port "node_exporter" { static = 9100 }
      port "cadvisor" { static = 9338 }
    }

    task "node-exporter" {
      driver = "docker"
      config {
        image        = "@@IMAGE_NODE_EXPORTER@@"
        network_mode = "host"
        pid_mode     = "host"
        args = [
          "--path.rootfs=/host",
          "--collector.filesystem.mount-points-exclude=^/(dev|proc|sys|run|var/lib/docker/.+|opt/nomad/.+)($|/)",
        ]
        mount {
          type     = "bind"
          source   = "/"
          target   = "/host"
          readonly = true
          bind_options { propagation = "rslave" }
        }
      }
      resources {
        cpu    = 100
        memory = 128
      }
      service {
        name     = "node-exporter"
        provider = "nomad"
        port     = "node_exporter"
        tags     = ["metrics"]
      }
    }

    task "cadvisor" {
      driver = "docker"
      config {
        image        = "@@IMAGE_CADVISOR@@"
        network_mode = "host"
        privileged   = true
        args = [
          "--port=9338",
          "--docker_only=true",
          "--housekeeping_interval=15s",
          "--store_container_labels=false",
          "--disable_metrics=advtcp,cpu_topology,disk,hugetlb,memory_numa,percpu,process,referenced_memory,resctrl,sched,tcp,udp",
        ]
        devices = [{ host_path = "/dev/kmsg" }]
        mount {
          type     = "bind"
          source   = "/"
          target   = "/rootfs"
          readonly = true
        }
        mount {
          type     = "bind"
          source   = "/var/run"
          target   = "/var/run"
          readonly = true
        }
        mount {
          type     = "bind"
          source   = "/sys"
          target   = "/sys"
          readonly = true
        }
        mount {
          type     = "bind"
          source   = "/var/lib/docker"
          target   = "/var/lib/docker"
          readonly = true
        }
      }
      resources {
        cpu    = 200
        memory = 256
      }
      service {
        name     = "cadvisor"
        provider = "nomad"
        port     = "cadvisor"
        tags     = ["metrics"]
      }
    }
  }
}
