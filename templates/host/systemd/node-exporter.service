# node-exporter for the observability stack @@STACK_NAME@@ (INFRA_METRICS=node). Generated by render.sh.
[Unit]
Description=@@STACK_NAME@@ node-exporter
After=network-online.target
Wants=network-online.target

[Service]
User=@@STACK_NAME@@
Group=@@STACK_NAME@@
ExecStart=/usr/local/bin/node_exporter --web.listen-address=127.0.0.1:9100
Restart=always
RestartSec=5
