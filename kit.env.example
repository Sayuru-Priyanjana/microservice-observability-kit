# Observability kit settings. Copy to kit.env, edit, then run ./render.sh.
# Values are substituted as text: quote values with spaces; avoid #, & and backslashes.
# An empty value means "use the default" (shown in the comment).

# ---------------------------------------------------------------- what and where
# kubernetes | compose | nomad | host
TARGET=kubernetes
# Kubernetes namespace / Compose project and network / Nomad job / systemd unit prefix.
STACK_NAME=observability
# deployment.environment on all telemetry, and a label on every metric (e.g. production, staging).
ENVIRONMENT=production
# Apps to render: one folder each under apps/ (dashboards, instrumentation).
APPS="example"

# ---------------------------------------------------------------- sizing
# small  : up to ~5 services,  ~50 req/s
# medium : up to ~15 services, ~300 req/s   (measured: 10 Java services, ~260 req/s)
# large  : more than that (also consider TRACE_SAMPLE_RATIO below 1.0)
# Every value below overrides the preset. Memory as <n>Mi / <n>Gi (whole numbers).
SIZE=medium
PROMETHEUS_RETENTION_TIME=
PROMETHEUS_RETENTION_SIZE=
PROMETHEUS_VOLUME=
PROMETHEUS_MEMORY_REQUEST=
PROMETHEUS_MEMORY_LIMIT=
TEMPO_RETENTION=
TEMPO_VOLUME=
TEMPO_MEMORY_REQUEST=
TEMPO_MEMORY_LIMIT=
GATEWAY_MEMORY_LIMIT=
GRAFANA_MEMORY_LIMIT=
GRAFANA_VOLUME=1Gi
# Share of traces kept by the agents (1.0 = all, 0.25 = a quarter). Metrics are always complete.
TRACE_SAMPLE_RATIO=1.0

# ---------------------------------------------------------------- Grafana
# bundled : the kit runs its own Grafana with datasources and dashboards provisioned
# sidecar : (kubernetes) an existing Grafana with the dashboard sidecar: Rancher monitoring,
#           kube-prometheus-stack. Dashboards are ConfigMaps; datasources go into its Helm values.
# api     : any existing Grafana reachable over HTTP; out/grafana-api/import.sh adds datasources
#           and dashboards with a service-account token.
GRAFANA_MODE=bundled
# Port Grafana is published on (compose / nomad / host).
GRAFANA_PORT=3000
# kubernetes + bundled: create an Ingress for this host name (empty = no Ingress, use port-forward).
GRAFANA_INGRESS_HOST=
GRAFANA_INGRESS_CLASS=
# sidecar: namespace the sidecar watches (Rancher: cattle-dashboards; kube-prometheus-stack: its namespace).
DASHBOARD_NAMESPACE=cattle-dashboards
# api: how the EXISTING Grafana reaches this stack (empty = derived from TARGET; set it when
# Grafana runs elsewhere, e.g. http://10.0.0.5:9090 and http://10.0.0.5:3200).
PROMETHEUS_URL_FOR_GRAFANA=
TEMPO_URL_FOR_GRAFANA=

# ---------------------------------------------------------------- infrastructure metrics
# Container / node CPU, memory, restarts next to the traces:
# auto     : federate (kubernetes), cadvisor (compose), nomad (nomad), node (host)
# federate : (kubernetes) read them from the cluster's existing Prometheus (FEDERATE_FROM)
# cadvisor : (compose) run cAdvisor + node-exporter in the stack
# nomad    : (nomad) scrape Nomad services tagged "metrics"; out/infra.nomad.hcl runs
#            node-exporter + cAdvisor on every client
# node     : (host) scrape node-exporter on 127.0.0.1:9100
# none     : traces and app metrics only
INFRA_METRICS=auto
# Existing Prometheus with kube-state-metrics, cAdvisor and node-exporter (host:port, no http://).
# Rancher: prometheus-operated.cattle-monitoring-system.svc:9090
# kube-prometheus-stack: prometheus-operated.monitoring.svc:9090
FEDERATE_FROM=prometheus-operated.cattle-monitoring-system.svc:9090

# ---------------------------------------------------------------- kubernetes
# Storage class of the Prometheus / Tempo / Grafana volumes (empty = cluster default).
STORAGE_CLASS=

# ---------------------------------------------------------------- compose / nomad / host
# Address the OTLP (4317/4318) and Grafana ports listen on. 0.0.0.0 = reachable from other hosts.
BIND_ADDRESS=0.0.0.0
# Address of the Prometheus (9090) and Tempo (3200) ports: 127.0.0.1 = only from the stack's host.
ADMIN_BIND_ADDRESS=127.0.0.1
# Name of the machine the stack runs on: `instance` label of its host / container metrics, and the
# address apps are told to send OTLP to (empty = name of the machine running render.sh; nomad:
# NOMAD_NODE_NAME).
HOST_LABEL=

# ---------------------------------------------------------------- nomad
NOMAD_DATACENTERS='"dc1"'
NOMAD_NAMESPACE=default
# Node the stack is pinned to (its host volumes live there). Required for nomad.
NOMAD_NODE_NAME=
# Nomad API for service discovery, as seen from the stack's Prometheus. [[[ ]]] is a Nomad template
# expression (the node's IP), resolved when the job starts. With Nomad ACLs, Prometheus also needs a
# token (see docs/operations.md).
NOMAD_ADDR='http://[[[ env "attr.unique.network.ip-address" ]]]:4646'

# ---------------------------------------------------------------- host (systemd, no containers)
CONFIG_DIR=/etc/observability
DATA_DIR=/var/lib/observability

# ---------------------------------------------------------------- traces
# Server spans whose path matches are dropped (health checks, metrics endpoints). Empty = default:
# ^/(health|healthz|livez?|readyz?|ping|metrics|actuator/(health|info|prometheus).*)$
DROP_PATHS_REGEX=
# Extra low-cardinality span attributes as labels on span metrics, comma separated (e.g. user.action).
SPAN_METRICS_DIMENSIONS=

# ---------------------------------------------------------------- images (pin; mirror for air-gapped)
IMAGE_OTEL_COLLECTOR=otel/opentelemetry-collector-contrib:0.162.0
IMAGE_PROMETHEUS=prom/prometheus:v3.15.0
IMAGE_TEMPO=grafana/tempo:3.1.0
IMAGE_GRAFANA=grafana/grafana:12.1.1
IMAGE_JAVA_AGENT=ghcr.io/open-telemetry/opentelemetry-operator/autoinstrumentation-java:2.32.0
IMAGE_CADVISOR=gcr.io/cadvisor/cadvisor:v0.52.1
IMAGE_NODE_EXPORTER=prom/node-exporter:v1.9.1
# Java agent jar for nomad / host (downloaded by Nomad's artifact block, or by you).
JAVA_AGENT_URL=https://github.com/open-telemetry/opentelemetry-java-instrumentation/releases/download/v2.32.0/opentelemetry-javaagent.jar
