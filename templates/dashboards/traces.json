{
  "uid": "@@UID_PREFIX@@traces",
  "title": "@@TITLE_PREFIX@@Traces",
  "tags": [
    "traces",
    "tempo",
    "@@APP_NAME@@"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h"
    ]
  },
  "templating": {
    "list": [
      {
        "name": "trace",
        "label": "Trace ID",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "hide": 0
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "obs-prometheus"
        },
        "query": {
          "query": "label_values(traces_spanmetrics_calls_total{service=~\"@@SERVICE_REGEX@@\"}, service)",
          "refId": "service"
        },
        "definition": "label_values(traces_spanmetrics_calls_total{service=~\"@@SERVICE_REGEX@@\"}, service)",
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "links": [
    {
      "title": "Service Monitoring (Kubernetes)",
      "type": "link",
      "url": "/d/@@UID_PREFIX@@service-monitoring-k8s/service-monitoring-kubernetes",
      "icon": "dashboard",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    },
    {
      "title": "Rancher / Node",
      "type": "link",
      "url": "/d/rancher-node-1/rancher-node",
      "icon": "dashboard"
    },
    {
      "title": "Actions",
      "type": "link",
      "url": "/d/@@UID_PREFIX@@actions/actions",
      "icon": "apps",
      "keepTime": true,
      "includeVars": true,
      "targetBlank": false
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Service graph (Tempo metrics-generator)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "nodeGraph",
      "title": "Service graph",
      "datasource": {
        "type": "tempo",
        "uid": "obs-tempo"
      },
      "description": "Built from traces_service_graph_* series (all services; the graph is not filtered). redis is a virtual node derived from the db.system attribute of client spans.",
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 14,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "obs-tempo"
          },
          "refId": "A",
          "queryType": "serviceMap"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Calls between services (edges)",
      "description": "traces_service_graph_request_total per edge.",
      "datasource": {
        "type": "prometheus",
        "uid": "obs-prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 1,
        "w": 10,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "obs-prometheus"
          },
          "expr": "sum by (client, server) (rate(traces_service_graph_request_total{client=~\"$service\"}[$__rate_interval])) or sum by (client, server) (rate(traces_service_graph_request_total{server=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{client}} → {{server}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3
    },
    {
      "type": "timeseries",
      "title": "Failed calls between services",
      "description": "traces_service_graph_request_failed_total per edge.",
      "datasource": {
        "type": "prometheus",
        "uid": "obs-prometheus"
      },
      "gridPos": {
        "x": 14,
        "y": 7,
        "w": 10,
        "h": 6
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "obs-prometheus"
          },
          "expr": "sum by (client, server) (rate(traces_service_graph_request_failed_total{client=~\"$service\"}[$__rate_interval])) or sum by (client, server) (rate(traces_service_graph_request_failed_total{server=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{client}} → {{server}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 4
    },
    {
      "id": 5,
      "type": "row",
      "title": "Per service: incoming requests (server spans)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Request rate per service",
      "description": "traces_spanmetrics_calls_total (server spans = requests a service receives).",
      "datasource": {
        "type": "prometheus",
        "uid": "obs-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "obs-prometheus"
          },
          "expr": "sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Error rate % per service",
      "description": "Spans with status ERROR / all spans (server spans = requests a service receives).",
      "datasource": {
        "type": "prometheus",
        "uid": "obs-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "obs-prometheus"
          },
          "expr": "100 * (sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or (0 * sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))) / sum by (service) (rate(traces_spanmetrics_calls_total{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "p95 latency per service",
      "description": "traces_spanmetrics_latency_bucket (server spans = requests a service receives). Exemplars link to traces.",
      "datasource": {
        "type": "prometheus",
        "uid": "obs-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "obs-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\", span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8
    },
    {
      "id": 9,
      "type": "row",
      "title": "Per operation (span_name, all span kinds)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Request rate per span_name",
      "description": "traces_spanmetrics_calls_total (every span: server, client (httpx, redis) and internal).",
      "datasource": {
        "type": "prometheus",
        "uid": "obs-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "obs-prometheus"
          },
          "expr": "sum by (service, span_name) (rate(traces_spanmetrics_calls_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}} · {{span_name}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Error rate % per span_name",
      "description": "Spans with status ERROR / all spans (every span: server, client (httpx, redis) and internal).",
      "datasource": {
        "type": "prometheus",
        "uid": "obs-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "obs-prometheus"
          },
          "expr": "100 * (sum by (service, span_name) (rate(traces_spanmetrics_calls_total{service=~\"$service\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval])) or (0 * sum by (service, span_name) (rate(traces_spanmetrics_calls_total{service=~\"$service\"}[$__rate_interval])))) / sum by (service, span_name) (rate(traces_spanmetrics_calls_total{service=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service}} · {{span_name}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "p95 latency per span_name",
      "description": "traces_spanmetrics_latency_bucket (every span: server, client (httpx, redis) and internal). Exemplars link to traces.",
      "datasource": {
        "type": "prometheus",
        "uid": "obs-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "obs-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, service, span_name) (rate(traces_spanmetrics_latency_bucket{service=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{service}} · {{span_name}}",
          "refId": "A",
          "range": true,
          "instant": false,
          "exemplar": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 12
    },
    {
      "id": 13,
      "type": "row",
      "title": "Recent traces for $service (TraceQL)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "table",
      "title": "Slow traces (> 300 ms)",
      "description": "Traces that include the selected service and took longer than 300 ms end-to-end. Click a trace ID to open it.",
      "datasource": {
        "type": "tempo",
        "uid": "obs-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "obs-tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && traceDuration > 300ms }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(traceID|Trace ID)$/"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show trace",
                    "url": "/d/@@UID_PREFIX@@traces/traces?${__url_time_range}&${service:queryparam}&var-trace=${__value.raw}&viewPanel=panel-16",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 14
    },
    {
      "type": "table",
      "title": "Error traces",
      "description": "Traces with at least one span in status ERROR in the selected service.",
      "datasource": {
        "type": "tempo",
        "uid": "obs-tempo"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "obs-tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && status = error }",
          "limit": 20,
          "tableType": "traces"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "/^(traceID|Trace ID)$/"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show trace",
                    "url": "/d/@@UID_PREFIX@@traces/traces?${__url_time_range}&${service:queryparam}&var-trace=${__value.raw}&viewPanel=panel-16",
                    "targetBlank": false
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 15
    },
    {
      "type": "table",
      "title": "Error spans",
      "description": "One row per span with status ERROR in the selected service: which operation failed, with its HTTP status and error message. Click a span ID to open its trace (the failing span has a red error icon).",
      "datasource": {
        "type": "tempo",
        "uid": "obs-tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 42,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "obs-tempo"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && status = error } | select(resource.service.name, span.http.request.method, span.http.route, span.http.response.status_code, statusMessage, event.exception.message)",
          "limit": 50,
          "spss": 20,
          "tableType": "spans"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "service.name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Service"
              },
              {
                "id": "custom.width",
                "value": 200
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "name"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Span"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "http.request.method"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Method"
              },
              {
                "id": "custom.width",
                "value": 80
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "http.route"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Route"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "http.response.status_code"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "HTTP status"
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^5\\d\\d$",
                      "result": {
                        "color": "red",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^4\\d\\d$",
                      "result": {
                        "color": "orange",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Status"
              },
              {
                "id": "custom.width",
                "value": 110
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "regex",
                    "options": {
                      "pattern": "^error$",
                      "result": {
                        "color": "red",
                        "index": 0
                      }
                    }
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "statusMessage"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Error message"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "event.exception.message"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Exception"
              }
            ]
          },
          {
