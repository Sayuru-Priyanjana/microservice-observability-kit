          },
          "refId": "A",
          "expr": "sum by (service_name, instance) ({__name__=~\"jvm_memory_used(_bytes)?\", service_name=~\"$service\", instance=~\"$instance\", jvm_memory_type=\"heap\"})",
          "legendFormat": "{{service_name}} {{instance}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Heap used % of max",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "obs-prometheus"
      },
      "description": "Close to 100% for long = too little heap (GC storms, OutOfMemoryError).",
      "gridPos": {
        "x": 12,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "obs-prometheus"
          },
          "refId": "A",
          "expr": "100 * sum by (service_name, instance) ({__name__=~\"jvm_memory_used(_bytes)?\", service_name=~\"$service\", instance=~\"$instance\", jvm_memory_type=\"heap\"}) / sum by (service_name, instance) ({__name__=~\"jvm_memory_limit(_bytes)?\", service_name=~\"$service\", instance=~\"$instance\", jvm_memory_type=\"heap\"})",
          "legendFormat": "{{service_name}} {{instance}}"
        }
      ]
    },
    {
