      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "obs-prometheus"
          },
          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\", instance=~\"$instance\"}[$__rate_interval])) or sum by (service_name) (rate(http_server_duration_milliseconds_count{service_name=~\"$service\", instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
