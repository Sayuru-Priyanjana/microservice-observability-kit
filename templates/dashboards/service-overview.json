          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Requests / s per route (top 15)",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "obs-prometheus"
      },
      "description": "http_route is only set by instrumentations that know the route template (Spring, JAX-RS, Express, ...).",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
