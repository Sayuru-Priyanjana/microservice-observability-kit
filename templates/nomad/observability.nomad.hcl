# Observability stack @@STACK_NAME@@ (Nomad, Docker driver). Generated by render.sh.
# Run from THIS folder (config files are read with file() relative to the working directory):
#   nomad var put -namespace @@NOMAD_NAMESPACE@@ nomad/jobs/@@STACK_NAME@@ grafana_admin_password=<password>
#   nomad job run observability.nomad.hcl
# Needs the host volumes in client-host-volumes.hcl on node @@NOMAD_NODE_NAME@@.
# All tasks use host networking on that node:
#   OTLP 4317 / 4318 and Grafana @@GRAFANA_PORT@@ on @@BIND_ADDRESS@@,
#   Prometheus 9090 / Tempo 3200 on @@ADMIN_BIND_ADDRESS@@, everything else on loopback.
# Config files are rendered with delimiters [[[ ]]] so Prometheus / Grafana `{{ }}` stay literal.

job "@@STACK_NAME@@" {
  datacenters = [@@NOMAD_DATACENTERS@@]
  namespace   = "@@NOMAD_NAMESPACE@@"
  type        = "service"

  constraint {
    attribute = "${node.unique.name}"
    value     = "@@NOMAD_NODE_NAME@@"
  }

  group "stack" {
    count = 1

    network {
      mode = "host"
      port "otlp_grpc" { static = 4317 }
      port "otlp_http" { static = 4318 }
      port "prometheus" { static = 9090 }
      port "tempo" { static = 3200 }
#@if grafana-bundled
      port "grafana" { static = @@GRAFANA_PORT@@ }
#@endif
    }

    volume "prometheus" {
      type      = "host"
      source    = "@@STACK_NAME@@-prometheus"
      read_only = false
    }
    volume "tempo" {
      type      = "host"
      source    = "@@STACK_NAME@@-tempo"
      read_only = false
    }
#@if grafana-bundled
    volume "grafana" {
      type      = "host"
      source    = "@@STACK_NAME@@-grafana"
      read_only = false
    }
#@endif

    restart {
      attempts = 10
      interval = "30m"
      delay    = "15s"
      mode     = "delay"
    }

    # ------------------------------------------------------------------ OTel Collector gateway
    task "otel-collector" {
      driver = "docker"
      config {
        image        = "@@IMAGE_OTEL_COLLECTOR@@"
        network_mode = "host"
        args         = ["--config=/local/config.yaml"]
      }
      template {
        data            = file("config/otel-collector/config.yaml")
        destination     = "local/config.yaml"
        left_delimiter  = "[[["
        right_delimiter = "]]]"
        change_mode     = "restart"
      }
      resources {
        cpu    = 200
        memory = @@GATEWAY_MEMORY_LIMIT_MB@@
      }
      # Apps find the gateway with: {{ range nomadService "@@STACK_NAME@@-otlp" }}{{ .Address }}:{{ .Port }}{{ end }}
      service {
        name     = "@@STACK_NAME@@-otlp"
        provider = "nomad"
        port     = "otlp_grpc"
        check {
          type     = "tcp"
          interval = "15s"
          timeout  = "3s"
        }
      }
    }

    # ------------------------------------------------------------------ Prometheus
    task "prometheus" {
      driver = "docker"
      user   = "65534"
      config {
        image        = "@@IMAGE_PROMETHEUS@@"
        network_mode = "host"
        args = [
          "--config.file=/local/prometheus.yml",
          "--storage.tsdb.path=/prometheus",
          "--storage.tsdb.retention.time=@@PROMETHEUS_RETENTION_TIME@@",
          "--storage.tsdb.retention.size=@@PROMETHEUS_RETENTION_SIZE@@",
          "--web.listen-address=@@ADMIN_BIND_ADDRESS@@:9090",
          "--web.enable-lifecycle",
          "--web.enable-remote-write-receiver",
          "--enable-feature=exemplar-storage",
        ]
      }
      volume_mount {
        volume      = "prometheus"
        destination = "/prometheus"
      }
      template {
        data            = file("config/prometheus/prometheus.yml")
        destination     = "local/prometheus.yml"
        left_delimiter  = "[[["
        right_delimiter = "]]]"
        change_mode     = "restart"
      }
      template {
        data            = file("config/prometheus/rules/alerts.yml")
        destination     = "local/rules/alerts.yml"
        left_delimiter  = "[[["
        right_delimiter = "]]]"
        change_mode     = "restart"
      }
      resources {
        cpu    = 500
        memory = @@PROMETHEUS_MEMORY_LIMIT_MB@@
      }
      service {
        name     = "@@STACK_NAME@@-prometheus"
        provider = "nomad"
        port     = "prometheus"
      }
    }

    # ------------------------------------------------------------------ Tempo
    task "tempo" {
      driver = "docker"
      user   = "10001"
      config {
        image        = "@@IMAGE_TEMPO@@"
        network_mode = "host"
        args         = ["-target=all", "-config.file=/local/tempo.yaml"]
      }
      volume_mount {
        volume      = "tempo"
        destination = "/var/tempo"
      }
      template {
        data            = file("config/tempo/tempo.yaml")
        destination     = "local/tempo.yaml"
        left_delimiter  = "[[["
        right_delimiter = "]]]"
        change_mode     = "restart"
      }
      resources {
        cpu    = 500
        memory = @@TEMPO_MEMORY_LIMIT_MB@@
      }
      service {
        name     = "@@STACK_NAME@@-tempo"
        provider = "nomad"
        port     = "tempo"
      }
    }
#@if grafana-bundled

    # ------------------------------------------------------------------ Grafana
    task "grafana" {
      driver = "docker"
      user   = "472"
      config {
        image        = "@@IMAGE_GRAFANA@@"
        network_mode = "host"
      }
      volume_mount {
        volume      = "grafana"
        destination = "/var/lib/grafana"
      }
      env {
        GF_SERVER_HTTP_ADDR            = "@@BIND_ADDRESS@@"
        GF_SERVER_HTTP_PORT            = "@@GRAFANA_PORT@@"
        GF_PATHS_PROVISIONING          = "/local/provisioning"
        GF_SECURITY_ADMIN_USER         = "admin"
        GF_USERS_ALLOW_SIGN_UP         = "false"
        GF_AUTH_ANONYMOUS_ENABLED      = "false"
        GF_ANALYTICS_REPORTING_ENABLED = "false"
        GF_ANALYTICS_CHECK_FOR_UPDATES = "false"
        GF_SECURITY_DISABLE_GRAVATAR   = "true"
        GF_LOG_MODE                    = "console"
      }
      # Admin password from the Nomad variable (only used when the database is created).
      template {
        data        = "{{ with nomadVar \"nomad/jobs/@@STACK_NAME@@\" }}GF_SECURITY_ADMIN_PASSWORD={{ .grafana_admin_password }}{{ end }}"
        destination = "secrets/grafana.env"
        env         = true
      }
      template {
        data            = file("grafana/provisioning/datasources/datasources.yaml")
        destination     = "local/provisioning/datasources/datasources.yaml"
        left_delimiter  = "[[["
        right_delimiter = "]]]"
        change_mode     = "restart"
      }
      template {
        data            = file("grafana/provisioning/dashboards/provider.yaml")
        destination     = "local/provisioning/dashboards/provider.yaml"
        left_delimiter  = "[[["
        right_delimiter = "]]]"
        change_mode     = "restart"
      }
      # @@GRAFANA_DASHBOARD_TEMPLATES@@
      resources {
        cpu    = 200
        memory = @@GRAFANA_MEMORY_LIMIT_MB@@
      }
      service {
        name     = "@@STACK_NAME@@-grafana"
        provider = "nomad"
        port     = "grafana"
        check {
          type     = "http"
          path     = "/api/health"
          interval = "30s"
          timeout  = "5s"
        }
      }
    }
#@endif
  }
}
