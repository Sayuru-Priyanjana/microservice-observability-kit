# OpenTelemetry settings for the services of app @@APP_NAME@@ (target @@TARGET@@). Generated by render.sh.
# Use one copy per service (systemd EnvironmentFile=, docker --env-file, compose env_file:).
#
# REQUIRED per service: the service name. It must match SERVICE_REGEX (@@SERVICE_REGEX@@),
# otherwise the app's dashboards do not show it.
#OTEL_SERVICE_NAME=<service>

# host.name becomes the `instance` label: use the name of the machine the service runs on.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=@@ENVIRONMENT@@,host.name=@@HOST_LABEL@@
OTEL_EXPORTER_OTLP_ENDPOINT=@@OTLP_ENDPOINT@@
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_TRACES_EXPORTER=otlp
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=none
# W3C trace context + baggage: traces continue across services, user.action travels along.
OTEL_PROPAGATORS=tracecontext,baggage
# Push metrics every 15 s (the Prometheus scrape interval; SDK default 60 s).
OTEL_METRIC_EXPORT_INTERVAL=15000
OTEL_TRACES_SAMPLER=@@OTEL_TRACES_SAMPLER@@
OTEL_TRACES_SAMPLER_ARG=@@TRACE_SAMPLE_RATIO@@

# Java: the OTel Java agent (@@JAVA_AGENT_URL@@). Other languages: see docs/instrumentation.md.
JAVA_TOOL_OPTIONS=-javaagent:@@JAVA_AGENT_PATH@@
