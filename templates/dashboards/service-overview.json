          "refId": "A",
          "expr": "sum by (service_name) (rate(http_server_request_duration_seconds_count{service_name=~\"$service\", instance=~\"$instance\", http_response_status_code=~\"5..\"}[$__rate_interval])) or sum by (service_name) (rate(http_server_duration_milliseconds_count{service_name=~\"$service\", instance=~\"$instance\", http_status_code=~\"5..\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 latency per service",
      "id": 9,
      "datasource": {
