# Tempo of the observability stack @@STACK_NAME@@. Generated by render.sh.
[Unit]
Description=@@STACK_NAME@@ Tempo
After=network-online.target @@STACK_NAME@@-prometheus.service
Wants=network-online.target

[Service]
User=@@STACK_NAME@@
Group=@@STACK_NAME@@
ExecStart=/usr/local/bin/tempo -target=all -config.file=@@CONFIG_DIR@@/tempo/tempo.yaml
Restart=always
RestartSec=5
MemoryMax=@@TEMPO_MEMORY_LIMIT_SYSTEMD@@
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=@@DATA_DIR@@/tempo

[Install]
WantedBy=multi-user.target
