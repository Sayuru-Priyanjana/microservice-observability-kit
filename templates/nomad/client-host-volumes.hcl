# Host volumes for the observability stack @@STACK_NAME@@. Generated by render.sh.
# On node @@NOMAD_NODE_NAME@@: create the directories with the owners the containers run as,
#   sudo mkdir -p /opt/@@STACK_NAME@@/{prometheus,tempo,grafana}
#   sudo chown 65534:65534 /opt/@@STACK_NAME@@/prometheus
#   sudo chown 10001:10001 /opt/@@STACK_NAME@@/tempo
#   sudo chown 472:472     /opt/@@STACK_NAME@@/grafana
# then merge this block into the Nomad client configuration and restart the Nomad agent.
# Bind mounts in the infra job need `volumes { enabled = true }` in the Docker plugin config,
# and cAdvisor needs `allow_privileged = true`.
client {
  host_volume "@@STACK_NAME@@-prometheus" {
    path      = "/opt/@@STACK_NAME@@/prometheus"
    read_only = false
  }
  host_volume "@@STACK_NAME@@-tempo" {
    path      = "/opt/@@STACK_NAME@@/tempo"
    read_only = false
  }
  host_volume "@@STACK_NAME@@-grafana" {
    path      = "/opt/@@STACK_NAME@@/grafana"
    read_only = false
  }
}
